# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
dist-electron/
out/
release/
*.tsbuildinfo

# Env
.env
.env.*
!.env.example

# Local runtime data (daemon-owned; never commit).
# Anchored on purpose: a bare `data/` also matched apps/main/src/data, which is source.
/data/
*.sqlite
*.sqlite-wal
*.sqlite-shm
archive/
artifacts/
logs/

# OCR assets are downloaded by scripts/fetch-ocr-assets.mjs (~45 MB).
/resources/ocr/models/
/resources/ocr/ort/
/resources/ocr/manifest.json

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
