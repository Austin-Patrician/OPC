{
  "name": "opc-platform",
  "productName": "OPC Agent 工作台",
  "version": "0.1.0",
  "private": true,
  "main": "./out/main/index.js",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "prebuild": "node scripts/fetch-ocr-assets.mjs --check",
    "build": "electron-vite build",
    "ocr:assets": "node scripts/fetch-ocr-assets.mjs",
    "start": "electron-vite preview",
    "pack:mac": "pnpm build && electron-builder --mac --dir",
    "dist:mac": "pnpm build && electron-builder --mac",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "format": "prettier --write .",
    "postinstall": "electron-builder install-app-deps && node scripts/fetch-ocr-assets.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^1.4.0",
    "@earendil-works/pi-durable": "^1.4.0",
    "better-sqlite3": "^13.0.3",
    "jiti": "^2.7.0",
    "sqlite-vec": "^0.1.6",
    "typebox": "^1.3.27"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@opc/shared": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "43.1.0",
    "electron-builder": "latest",
    "electron-vite": "latest",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "better-sqlite3",
      "esbuild",
      "electron-winstaller"
    ]
  }
}
